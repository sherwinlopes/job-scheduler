{
  "dashboard": {
    "title": "Job Scheduler",
    "panels": [
      {
        "title": "Jobs Executed (rate)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(scheduler_jobs_executed_total[5m])",
            "legendFormat": "executed/s"
          }
        ]
      },
      {
        "title": "Jobs Failed (rate)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "rate(scheduler_jobs_failed_total[5m])",
            "legendFormat": "failed/s"
          }
        ]
      },
      {
        "title": "Execution Duration (p95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(scheduler_jobs_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          }
        ]
      },
      {
        "title": "Active Workers",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "count(up{job=\"workers\"} == 1)",
            "legendFormat": "workers"
          }
        ]
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "10s"
  }
}
